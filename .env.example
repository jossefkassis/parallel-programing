DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ecommerce_demo_nest?schema=public"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PORT=3000
INSTANCE_NAME=app-local
FAKE_PAYMENT_SECRET=replace-with-a-random-secret
QUEUE_CONCURRENCY=4
SERVICE_CONCURRENCY=8

# Local Docker container values, kept here because they document the services
# exposed from Docker Desktop. The NestJS app primarily uses DATABASE_URL,
# REDIS_HOST, and REDIS_PORT above.
APP_NAME="Laravel E-Commerce Demo"
APP_ENV=local
APP_KEY=base64:replace-with-your-app-key
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_INSTANCE=local

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ecommerce_demo_nest
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DEMO_SLOW_REQUEST_MS=500
DEMO_SLOW_QUERY_MS=100
